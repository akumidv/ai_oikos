{
  "name": "oikos",
  "version": "0.1.0",
  "private": true,
  "description": "oikos — an assistant for working with an organization's resources: code hosting, task tracking, wiki, messaging, mail and files, documents",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "jira": "node tools/jira/cli.mjs",
    "confluence": "node tools/confluence/cli.mjs",
    "gitlab": "node tools/gitlab/cli.mjs",
    "github": "node tools/github/cli.mjs",
    "browser": "node tools/browser/cli.mjs",
    "google": "node tools/google/cli.mjs",
    "documents": "node tools/documents/cli.mjs",
    "setup": "node tools/setup/cli.mjs",
    "resources": "node tools/landscape/cli.mjs resources",
    "skills": "node tools/landscape/cli.mjs skills",
    "sync": "node tools/sync/cli.mjs",
    "check": "node tools/sync/cli.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "yaml": "^2.9.1"
  }
}
