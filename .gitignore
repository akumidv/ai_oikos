# An installation's private folder: never in the core (the tests make theirs in a temporary folder)
.local/
# The core's own hook wiring — settings.json — is tracked, so a clone is guarded on the first
# start; what Claude Code fixes itself and what a session leaves beside the wiring is not.
.claude/settings.local.json
.claude/worktrees/
.qwen/settings.local.json
.qwen/worktrees/
.qwen/tmp/
CLAUDE.local.md
.env
# Generated by sync in an installation (the core repository has none); kept out if one appears here
.mcp.json

node_modules/

# secrets
*.env
!*.env.example

# dev-layer venv (provisioned only when the project has no Python environment)
_aitna/.venv/

# akmon model routing — per-user/per-session artifacts (never committed)
.claude/model-routing.local.json
.claude/model-routing.log
.claude/second-opinion/
.claude/agents/k_*.md
