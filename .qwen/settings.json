{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$QWEN_PROJECT_DIR/tools/hooks/host-hook.mjs\" session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$QWEN_PROJECT_DIR/tools/hooks/host-hook.mjs\" write-guard",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$QWEN_PROJECT_DIR/tools/hooks/host-hook.mjs\" context-pressure",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$QWEN_PROJECT_DIR/tools/hooks/host-hook.mjs\" write-guard",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$QWEN_PROJECT_DIR/tools/hooks/host-hook.mjs\" git-guard",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$QWEN_PROJECT_DIR/tools/hooks/host-hook.mjs\" secret-guard",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(read_file|grep_search|glob|list_directory|zoom_image|lsp|edit|write_file|notebook_edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$QWEN_PROJECT_DIR/tools/hooks/host-hook.mjs\" secret-guard",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$QWEN_PROJECT_DIR/tools/hooks/host-hook.mjs\" package-guard",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^agent$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$QWEN_PROJECT_DIR/tools/hooks/host-hook.mjs\" context-pressure",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "$version": 4
}
